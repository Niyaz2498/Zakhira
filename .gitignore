# ── Dependencies ─────────────────────────────────────────────────────────────
node_modules/
.pnpm-store/

# ── Build outputs ─────────────────────────────────────────────────────────────
dist/
build/
out/
*.tsbuildinfo
dist-release/
*.apk
*.aab

# ── Package compiled outputs (generated by tsc) ───────────────────────────────
packages/*/src/*.js
packages/*/src/*.js.map
packages/*/src/*.d.ts
packages/*/src/*.d.ts.map

# ── Turbo ────────────────────────────────────────────────────────────────────
.turbo/

# ── Tauri (Rust build artifacts) ─────────────────────────────────────────────
**/src-tauri/target/
# Regenerated by tauri-build from capabilities/ + installed plugins on every
# compile — tracking it just produces churn in every diff.
**/src-tauri/gen/schemas/

# ── Cloudflare / Wrangler ────────────────────────────────────────────────────
.wrangler/

# ── Environment / secrets ─────────────────────────────────────────────────────
.env
.env.local
.env.*.local
.env.development
.env.production
.dev.vars
*.secret

# ── Expo / Mobile ─────────────────────────────────────────────────────────────
.expo/
# Native projects are generated by `expo prebuild` (CNG), never committed.
# CI regenerates android/ on every release — see docs/RELEASING.md.
apps/mobile/android/
apps/mobile/ios/
*.jks
*.keystore
*.p8
*.p12
*.key
*.pem
*.mobileprovision
*.orig.*

# ── Logs ─────────────────────────────────────────────────────────────────────
*.log
bugreport-*.zip
npm-debug.log*
pnpm-debug.log*
yarn-debug.log*
yarn-error.log*

# ── OS ───────────────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db

# ── Editor ───────────────────────────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
